# --- Action: reboot_modem ---
action_reboot_modem() {
    (
        sleep 1
        $AT_HELPER -t 2 "AT+CFUN=1,1" >/dev/null 2>&1
    ) &
    jq -n '{success: true, message: "蜂窝模组正在软重启中 (预计 15~30 秒重新连接)"}'
}

# --- Action: send_at ---
action_send_at() {
    local input=$(cat)
    local cmd=$(echo "$input" | jq -r '.cmd // ""' | tr -d '\r\n')

    if [ -z "$cmd" ]; then
        jq -n '{success: false, error: "EMPTY_COMMAND", message: "AT 指令不能为空"}'
        return 0
    fi

    case "$cmd" in
        AT*|at*|At*|aT*) ;;
        *)
            jq -n '{success: false, error: "INVALID_PREFIX", message: "指令必须以 AT 开头"}'
            return 0
            ;;
    esac

    case "$cmd" in
        *";"*|*"|"*|*"&"*|*"\`"*|*"$"*)
            jq -n '{success: false, error: "DISALLOWED_CHAR", message: "指令包含非法字符"}'
            return 0
            ;;
    esac

    if [ "${#cmd}" -gt 256 ]; then
        jq -n '{success: false, error: "TOO_LONG", message: "指令长度超出 256 字符限制"}'
        return 0
    fi

    local res=$(run_at "$cmd" 5)
    jq -n \
        --arg cmd "$cmd" \
        --arg response "$res" \
        '{
            success: true,
            cmd: $cmd,
            response: $response
        }'
}

# --- Action: sms_recv ---
action_sms_recv() {
    local raw
    raw=$($AT_HELPER --sms-recv 2>/dev/null)
    local rc=$?

    if [ "$rc" -ne 0 ] || ! echo "$raw" | jq . >/dev/null 2>&1; then
        raw='{"msg":[]}'
    fi

    local current_json='{"messages":[]}'
    if [ -f /tmp/mt571x_sms.json ]; then
        current_json=$(cat /tmp/mt571x_sms.json 2>/dev/null)
        if ! echo "$current_json" | jq . >/dev/null 2>&1; then
            current_json='{"messages":[]}'
        fi
    fi

    local merged
    merged=$(jq -n \
        --argjson incoming "$raw" \
        --argjson existing "$current_json" '
        ($incoming.msg // []) as $new_msgs |
        ($existing.messages // []) as $old_msgs |
        ($new_msgs | map({
            id: ((.sender // "unknown") + "_" + (.timestamp // "") + "_" + (.index | tostring)),
            index: .index,
            sender: (.sender // "未知号码"),
            timestamp: (.timestamp // "未知时间"),
            content: (.content // ""),
            storage: "SIM",
            received_at: (now | strftime("%Y-%m-%d %H:%M:%S"))
        })) as $formatted_new |
        ($formatted_new + $old_msgs | unique_by(.sender + .timestamp + .content)) as $all |
        {
            success: true,
            count: ($all | length),
            messages: $all,
            updated_at: (now | strftime("%Y-%m-%d %H:%M:%S"))
        }
    ' 2>/dev/null)

    if [ -n "$merged" ]; then
        echo "$merged" > /tmp/mt571x_sms.json
        echo "$merged"
    else
        echo '{"success": false, "count": 0, "messages": [], "error": "PARSE_FAILED"}'
    fi
}

# --- Action: sms_list ---
action_sms_list() {
    if [ -f /tmp/mt571x_sms.json ]; then
        cat /tmp/mt571x_sms.json
    else
        action_sms_recv
    fi
}

# --- Action: sms_delete ---
action_sms_delete() {
    local input=$(cat)
    local target_id=$(echo "$input" | jq -r '.id // ""')
    local target_index=$(echo "$input" | jq -r '.index // ""')

    if [ -n "$target_index" ] && [ "$target_index" != "null" ]; then
        run_at "AT+CMGD=$target_index" 4 >/dev/null 2>&1
    fi

    if [ -f /tmp/mt571x_sms.json ] && [ -n "$target_id" ]; then
        local updated
        updated=$(jq --arg id "$target_id" '
            .messages = (.messages | map(select(.id != $id))) |
            .count = (.messages | length) |
            .updated_at = (now | strftime("%Y-%m-%d %H:%M:%S"))
        ' /tmp/mt571x_sms.json 2>/dev/null)
        if [ -n "$updated" ]; then
            echo "$updated" > /tmp/mt571x_sms.json
        fi
    fi

    jq -n '{success: true, message: "短信已删除"}'
}

# --- Action: sms_clear_all ---
action_sms_clear_all() {
    run_at "AT+CMGD=1,4" 4 >/dev/null 2>&1
    echo '{"success": true, "count": 0, "messages": [], "updated_at": ""}' > /tmp/mt571x_sms.json
    jq -n '{success: true, message: "已清空所有临时短信与 SIM 卡短信"}'
}

# --- Main Dispatcher ---
case "$1" in
    list)
        action_list
        ;;
    call)
        case "$2" in
            status)            action_status ;;
            capabilities)      action_capabilities ;;
            neighbors)         action_neighbors ;;
            lock_nr_band)      action_lock_nr_band ;;
            lock_nr_cell)      action_lock_nr_cell ;;
            lock_nr_freq)      action_lock_nr_freq ;;
            unlock_nr)         action_unlock_nr ;;
            lock_lte_band)     action_lock_lte_band ;;
            lock_lte_cell)     action_lock_lte_cell ;;
            lock_lte_freq)     action_lock_lte_freq ;;
            unlock_lte)        action_unlock_lte ;;
            unlock_all)        action_unlock_all ;;
            restore_auto_mode) action_restore_auto_mode ;;
            set_network_mode)  action_set_network_mode ;;
            reboot_modem)      action_reboot_modem ;;
            send_at)           action_send_at ;;
            sms_list)          action_sms_list ;;
            sms_recv)          action_sms_recv ;;
            sms_delete)        action_sms_delete ;;
            sms_clear_all)     action_sms_clear_all ;;
            *)
                jq -n '{error: "METHOD_NOT_FOUND"}'
                exit 0
                ;;
        esac
        ;;
    *)
        echo "Usage: $0 {list|call <method>}" >&2
        exit 1
        ;;
esac
