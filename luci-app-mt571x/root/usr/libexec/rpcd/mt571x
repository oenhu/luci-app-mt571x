#!/bin/sh
# rpcd backend microservice for MT5710/MT5711 5G/4G Band Lock & AT Control
# Object: mt571x

AT_HELPER="/usr/bin/mt571x-at"

# Helper to send AT command and return output & exit code
run_at() {
    local cmd="$1"
    local timeout="${2:-3}"
    $AT_HELPER -t "$timeout" "$cmd" 2>/dev/null
}

