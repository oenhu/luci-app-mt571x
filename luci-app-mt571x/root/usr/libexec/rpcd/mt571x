# --- Action: status ---
action_status() {
    local at_port
    at_port=$($AT_HELPER --port 2>/dev/null)
    if [ -z "$at_port" ] || [ ! -e "$at_port" ]; then
        jq -n '{
            online: false,
            error: "MODEM_OFFLINE",
            message: "MT5710/MT5711 串口未就绪或未接入"
        }'
        return 0
    fi

    # Query key metrics
    local hfreq hcsq locinfo nrlock ltelock syscfg temp ssb

    hfreq=$(run_at 'AT^HFREQINFO?' 2 | grep '^\^HFREQINFO:' | tr -d '\r')
    hcsq=$(run_at 'AT^HCSQ?' 2 | grep '^\^HCSQ:' | tr -d '\r')
    locinfo=$(run_at 'AT^LOCINFO?' 2 | grep '^\^LOCINFO:' | tr -d '\r')
    nrlock=$(run_at 'AT^NRFREQLOCK?' 2 | grep -v 'OK' | tr '\r\n' ' ' | sed 's/  */ /g')
    ltelock=$(run_at 'AT^LTEFREQLOCK?' 2 | grep -v 'OK' | tr '\r\n' ' ' | sed 's/  */ /g')
    syscfg=$(run_at 'AT^SYSCFGEX?' 2 | grep '^\^SYSCFGEX:' | tr -d '\r')
    temp=$(run_at 'AT^CHIPTEMP?' 2 | grep '^\^CHIPTEMP:' | tr -d '\r')
    ssb=$(run_at 'AT^NRSSBID?' 3 | grep '^\^NRSSBID:' | tr -d '\r')

    # Parse HFREQINFO: 0,7,28,153628,768140,20000,142628,713140,20000
    local band="" dl_arfcn="" dl_freq_mhz="" dl_bw_mhz="" ul_arfcn="" ul_freq_mhz="" ul_bw_mhz=""
    if [ -n "$hfreq" ]; then
        local csv="${hfreq#*: }"
        band=$(echo "$csv" | cut -d, -f3)
        dl_arfcn=$(echo "$csv" | cut -d, -f4)
        local dl_freq_k=$(echo "$csv" | cut -d, -f5)
        local dl_bw_k=$(echo "$csv" | cut -d, -f6)
        ul_arfcn=$(echo "$csv" | cut -d, -f7)
        local ul_freq_k=$(echo "$csv" | cut -d, -f8)
        local ul_bw_k=$(echo "$csv" | cut -d, -f9)

        [ -n "$dl_freq_k" ] && dl_freq_mhz=$(awk -v v="$dl_freq_k" 'BEGIN { printf "%.3f", v / 1000 }')
        [ -n "$dl_bw_k" ] && dl_bw_mhz=$(awk -v v="$dl_bw_k" 'BEGIN { printf "%.1f", v / 1000 }')
        [ -n "$ul_freq_k" ] && ul_freq_mhz=$(awk -v v="$ul_freq_k" 'BEGIN { printf "%.3f", v / 1000 }')
        [ -n "$ul_bw_k" ] && ul_bw_mhz=$(awk -v v="$ul_bw_k" 'BEGIN { printf "%.1f", v / 1000 }')
    fi

    # Parse HCSQ: "NR",56,201,31
    local rat="NR" rsrp_raw="" sinr_raw="" rsrq_raw=""
    local rsrp="" sinr="" rsrq=""
    if [ -n "$hcsq" ]; then
        local r=$(echo "$hcsq" | sed -n 's/.*"\([^"]*\)".*/\1/p')
        [ -n "$r" ] && rat="$r"
        local vals=$(echo "$hcsq" | sed -n 's/^[^\"]*"[^\"]*",//p')
        rsrp_raw=$(echo "$vals" | cut -d, -f1)
        sinr_raw=$(echo "$vals" | cut -d, -f2)
        rsrq_raw=$(echo "$vals" | cut -d, -f3)

        if [ -n "$rsrp_raw" ]; then
            rsrp=$(( -140 + rsrp_raw ))
            [ -n "$sinr_raw" ] && sinr=$(awk -v v="$sinr_raw" 'BEGIN { printf "%.1f", -20.0 + (v * 0.2) }')
            [ -n "$rsrq_raw" ] && rsrq=$(awk -v v="$rsrq_raw" 'BEGIN { printf "%.1f", -19.5 + (v * 0.5) }')
        fi
    fi

    # Parse LOCINFO: 46015,0x465563,0xFF,0x17C5731F7
    local plmn="" tac="" cell_id="" oper_name="未知运营商"
    if [ -n "$locinfo" ]; then
        local l_csv="${locinfo#*: }"
        plmn=$(echo "$l_csv" | cut -d, -f1 | tr -d ' ')
        tac=$(echo "$l_csv" | cut -d, -f2 | tr -d ' ')
        cell_id=$(echo "$l_csv" | cut -d, -f4 | tr -d ' ')

        case "$plmn" in
            "46000"|"46002"|"46007"|"46008") oper_name="中国移动 (China Mobile)" ;;
            "46001"|"46006"|"46009") oper_name="中国联通 (China Unicom)" ;;
            "46003"|"46005"|"46011") oper_name="中国电信 (China Telecom)" ;;
            "46015") oper_name="中国广电 (China Broadnet)" ;;
            *) [ -n "$plmn" ] && oper_name="PLMN: $plmn" ;;
        esac
    fi

    # Parse SSB Serving Cell: ^NRSSBID: 152650,000000017c5731f7,128,-85,20,...
    local pci="" ssb_arfcn="" ssb_rsrp="" ssb_sinr=""
    if [ -n "$ssb" ]; then
        local ssb_body="${ssb#*: }"
        ssb_arfcn=$(echo "$ssb_body" | cut -d, -f1)
        [ -z "$cell_id" ] && cell_id=$(echo "$ssb_body" | cut -d, -f2)
        pci=$(echo "$ssb_body" | cut -d, -f3)
        ssb_rsrp=$(echo "$ssb_body" | cut -d, -f4)
        ssb_sinr=$(echo "$ssb_body" | cut -d, -f5)
        [ -z "$rsrp" ] && rsrp="$ssb_rsrp"
        [ -z "$sinr" ] && sinr="$ssb_sinr"
    fi

    # Parse Temperature: ^CHIPTEMP: 334,...
    local temp_c=""
    if [ -n "$temp" ]; then
        local t_val=$(echo "${temp#*: }" | cut -d, -f1)
        [ -n "$t_val" ] && temp_c=$(awk -v v="$t_val" 'BEGIN { printf "%.1f", v / 10.0 }')
    fi

    # Parse Lock Status:
    local nr_lock_state="0" nr_lock_detail="未锁定"
    if echo "$nrlock" | grep -q "\^NRFREQLOCK: 0"; then
        nr_lock_state="0"
        nr_lock_detail="未锁定"
    elif echo "$nrlock" | grep -q "\^NRFREQLOCK: 3"; then
        nr_lock_state="3"
        local lb=$(echo "$nrlock" | awk -F'0,1 ' '{print $2}' | xargs)
        nr_lock_detail="已锁定频段: n$lb"
    elif echo "$nrlock" | grep -q "\^NRFREQLOCK: 2"; then
        nr_lock_state="2"
        local lc=$(echo "$nrlock" | awk -F'0,1 ' '{print $2}' | xargs)
        nr_lock_detail="已锁定小区: $lc"
    elif echo "$nrlock" | grep -q "\^NRFREQLOCK: 1"; then
        nr_lock_state="1"
        local lf=$(echo "$nrlock" | awk -F'0,1 ' '{print $2}' | xargs)
        nr_lock_detail="已锁定频点: $lf"
    fi

    local lte_lock_state="0" lte_lock_detail="未锁定"
    if echo "$ltelock" | grep -q "\^LTEFREQLOCK: 0"; then
        lte_lock_state="0"
        lte_lock_detail="未锁定"
    elif echo "$ltelock" | grep -q "\^LTEFREQLOCK: 3"; then
        lte_lock_state="3"
        local lb=$(echo "$ltelock" | awk -F'0,1 ' '{print $2}' | xargs)
        lte_lock_detail="已锁定频段: B$lb"
    elif echo "$ltelock" | grep -q "\^LTEFREQLOCK: 2"; then
        lte_lock_state="2"
        local lc=$(echo "$ltelock" | awk -F'0,1 ' '{print $2}' | xargs)
        lte_lock_detail="已锁定小区: $lc"
    fi

    # Parse SYSCFGEX: "08",0,1,2,1E200000095
    local current_mode="" lte_band_mask=""
    if [ -n "$syscfg" ]; then
        current_mode=$(echo "$syscfg" | sed -n 's/.*"\([^"]*\)".*/\1/p')
        lte_band_mask=$(echo "${syscfg#*: }" | cut -d, -f5)
    fi

    # Read configured lock from UCI
    local conf_nr_mode conf_nr_bands conf_lte_mode conf_lte_bands
    conf_nr_mode=$(uci -q get mt571x.nr.mode || echo "none")
    conf_nr_bands=$(uci -q get mt571x.nr.bands || echo "")
    conf_lte_mode=$(uci -q get mt571x.lte.mode || echo "none")
    conf_lte_bands=$(uci -q get mt571x.lte.bands || echo "")

    # Output JSON using jq
    jq -n \
        --arg online "true" \
        --arg port "$at_port" \
        --arg model "MT5711_CN" \
        --arg vendor "TD Tech Ltd." \
        --arg rat "$rat" \
        --arg oper_name "$oper_name" \
        --arg plmn "$plmn" \
        --arg band "$band" \
        --arg dl_arfcn "$dl_arfcn" \
        --arg dl_freq_mhz "$dl_freq_mhz" \
        --arg dl_bw_mhz "$dl_bw_mhz" \
        --arg ul_arfcn "$ul_arfcn" \
        --arg ul_freq_mhz "$ul_freq_mhz" \
        --arg ul_bw_mhz "$ul_bw_mhz" \
        --arg pci "$pci" \
        --arg cell_id "$cell_id" \
        --arg tac "$tac" \
        --arg rsrp "$rsrp" \
        --arg sinr "$sinr" \
        --arg rsrq "$rsrq" \
        --arg temp "$temp_c" \
        --arg nr_lock_state "$nr_lock_state" \
        --arg nr_lock_detail "$nr_lock_detail" \
        --arg lte_lock_state "$lte_lock_state" \
        --arg lte_lock_detail "$lte_lock_detail" \
        --arg mode "$current_mode" \
        --arg lte_mask "$lte_band_mask" \
        --arg conf_nr_mode "$conf_nr_mode" \
        --arg conf_nr_bands "$conf_nr_bands" \
        --arg conf_lte_mode "$conf_lte_mode" \
        --arg conf_lte_bands "$conf_lte_bands" \
        '{
            online: ($online == "true"),
            port: $port,
            model: $model,
            vendor: $vendor,
            network: {
                rat: $rat,
                operator: $oper_name,
                plmn: $plmn,
                band: $band,
                dl_arfcn: (if $dl_arfcn != "" then ($dl_arfcn | tonumber) else null end),
                dl_freq_mhz: (if $dl_freq_mhz != "" then ($dl_freq_mhz | tonumber) else null end),
                dl_bw_mhz: (if $dl_bw_mhz != "" then ($dl_bw_mhz | tonumber) else null end),
                ul_arfcn: (if $ul_arfcn != "" then ($ul_arfcn | tonumber) else null end),
                ul_freq_mhz: (if $ul_freq_mhz != "" then ($ul_freq_mhz | tonumber) else null end),
                ul_bw_mhz: (if $ul_bw_mhz != "" then ($ul_bw_mhz | tonumber) else null end),
                pci: (if $pci != "" then ($pci | tonumber) else null end),
                cell_id: $cell_id,
                tac: $tac,
                mode: $mode,
                lte_mask: $lte_mask
            },
            signal: {
                rsrp: (if $rsrp != "" then ($rsrp | tonumber) else null end),
                sinr: (if $sinr != "" then ($sinr | tonumber) else null end),
                rsrq: (if $rsrq != "" then ($rsrq | tonumber) else null end),
                temperature: (if $temp != "" then ($temp | tonumber) else null end)
            },
            actual_lock: {
                nr_mode: $nr_lock_state,
                nr_detail: $nr_lock_detail,
                lte_mode: $lte_lock_state,
                lte_detail: $lte_lock_detail
            },
            configured_lock: {
                nr_mode: $conf_nr_mode,
                nr_bands: $conf_nr_bands,
                lte_mode: $conf_lte_mode,
                lte_bands: $conf_lte_bands
            }
        }'
}

# --- Action: neighbors ---
action_neighbors() {
    local ssb
    ssb=$(run_at 'AT^NRSSBID?' 3 | grep '^\^NRSSBID:' | tr -d '\r')
    if [ -z "$ssb" ]; then
        echo '{"count": 0, "neighbors": []}'
        return 0
    fi

    local body="${ssb#*: }"
    local serving_arfcn=$(echo "$body" | cut -d, -f1)
    local serving_pci=$(echo "$body" | cut -d, -f3)
    local serving_rsrp=$(echo "$body" | cut -d, -f4)
    local serving_sinr=$(echo "$body" | cut -d, -f5)

    echo "$body" | awk -F',' -v s_pci="$serving_pci" -v s_arfcn="$serving_arfcn" -v s_rsrp="$serving_rsrp" -v s_sinr="$serving_sinr" '
    BEGIN {
        print "{\"serving\":{\"pci\":" s_pci ",\"arfcn\":" s_arfcn ",\"rsrp\":" s_rsrp ",\"sinr\":" s_sinr "},\"neighbors\":["
        first = 1
    }
    {
        count = $23
        if (count > 0) {
            idx = 24
            for (i = 0; i < count; i++) {
                n_pci = $(idx)
                n_arfcn = $(idx+1)
                n_rsrp = $(idx+2)
                n_sinr = $(idx+3)
                if (n_pci != "" && n_pci != "255" && n_rsrp < 0) {
                    if (!first) printf ","
                    printf "{\"pci\":%d,\"arfcn\":%d,\"rsrp\":%d,\"sinr\":%d}", n_pci, n_arfcn, n_rsrp, n_sinr
                    first = 0
                }
                idx += 14
            }
        }
    }
    END {
        print "]}"
    }'
}

# --- Action: lock_nr_band ---
action_lock_nr_band() {
    local input=$(cat)
    local bands=$(echo "$input" | jq -r 'if .bands | type == "array" then .bands | join(",") else .bands // "" end' | tr -d ' ')
    if [ -z "$bands" ]; then
        jq -n '{success: false, error: "MISSING_BANDS", message: "请指定要锁定的 5G 频段"}'
        return 0
    fi

    local count=$(echo "$bands" | tr ',' '\n' | grep -v '^$' | wc -l)
    if [ "$count" -lt 1 ] || [ "$count" -gt 20 ]; then
        jq -n '{success: false, error: "INVALID_COUNT", message: "频段数量必须在 1~20 之间"}'
        return 0
    fi

    local at_cmd="AT^NRFREQLOCK=3,0,$count,\"$bands\""
    local res
    res=$(run_at "$at_cmd" 5)
    local rc=$?
    if [ "$rc" -eq 0 ] && ! echo "$res" | grep -qi "ERROR"; then
        uci set mt571x.nr.mode='band'
        uci set mt571x.nr.bands="$bands"
        uci commit mt571x
        run_at 'AT+COPS=0' 3 >/dev/null 2>&1 &
        jq -n \
            --arg cmd "$at_cmd" \
            --arg msg "已成功锁定 5G 频段 $bands" \
            '{success: true, cmd: $cmd, message: $msg}'
    else
        local err=$(echo "$res" | grep -E 'ERROR|\+CME' | head -n1 | tr -d '\r')
        [ -z "$err" ] && err="执行失败或超时"
        jq -n \
            --arg cmd "$at_cmd" \
            --arg err "锁频失败: $err" \
            '{success: false, error: "AT_ERROR", message: $err, cmd: $cmd}'
    fi
}

# --- Action: lock_nr_cell ---
action_lock_nr_cell() {
    local input=$(cat)
    local band=$(echo "$input" | jq -r '.band // ""' | tr -d ' ')
    local arfcn=$(echo "$input" | jq -r '.arfcn // ""' | tr -d ' ')
    local scs=$(echo "$input" | jq -r '.scs // ""' | tr -d ' ')
    local pci=$(echo "$input" | jq -r '.pci // ""' | tr -d ' ')

    if [ -z "$band" ] || [ -z "$arfcn" ] || [ -z "$pci" ]; then
        jq -n '{success: false, error: "MISSING_PARAMS", message: "必须提供 Band、ARFCN 与 PCI"}'
        return 0
    fi

    if [ -z "$scs" ]; then
        if [ "$band" -le 28 ]; then
            scs="0"
        else
            scs="1"
        fi
    fi

    local at_cmd="AT^NRFREQLOCK=2,0,1,\"$band\",\"$arfcn\",\"$scs\",\"$pci\""
    local res
    res=$(run_at "$at_cmd" 5)
    local rc=$?
    if [ "$rc" -eq 0 ] && ! echo "$res" | grep -qi "ERROR"; then
        uci set mt571x.nr.mode='cell'
        uci set mt571x.nr.bands="$band"
        uci set mt571x.nr.arfcn="$arfcn"
        uci set mt571x.nr.pci="$pci"
        uci set mt571x.nr.scs="$scs"
        uci commit mt571x
        run_at 'AT+COPS=0' 3 >/dev/null 2>&1 &
        jq -n \
            --arg cmd "$at_cmd" \
            --arg msg "已成功锁定 5G 小区 (n$band, ARFCN:$arfcn, PCI:$pci)" \
            '{success: true, cmd: $cmd, message: $msg}'
    else
        local err=$(echo "$res" | grep -E 'ERROR|\+CME' | head -n1 | tr -d '\r')
        [ -z "$err" ] && err="执行失败或超时"
        jq -n \
            --arg cmd "$at_cmd" \
            --arg err "锁定小区失败: $err" \
            '{success: false, error: "AT_ERROR", message: $err, cmd: $cmd}'
    fi
}

