# --- Action: unlock_all ---
action_unlock_all() {
    run_at 'AT^NRFREQLOCK=0' 4
    run_at 'AT^LTEFREQLOCK=0' 4

    uci set mt571x.nr.mode='none'
    uci set mt571x.nr.bands=''
    uci set mt571x.nr.arfcn=''
    uci set mt571x.nr.pci=''
    uci set mt571x.lte.mode='none'
    uci set mt571x.lte.bands=''
    uci set mt571x.lte.earfcn=''
    uci set mt571x.lte.pci=''
    uci commit mt571x
    run_at 'AT+COPS=0' 3 >/dev/null 2>&1 &

    jq -n '{success: true, message: "已成功解除 5G 与 4G 的所有锁定限制"}'
}

# --- Action: restore_auto_mode ---
action_restore_auto_mode() {
    run_at 'AT^NRFREQLOCK=0' 3
    run_at 'AT^LTEFREQLOCK=0' 3
    run_at 'AT^SYSCFGEX="08",0,1,2,7FFFFFFFFFFFFFFF' 5

    uci set mt571x.nr.mode='none'
    uci set mt571x.nr.bands=''
    uci set mt571x.lte.mode='none'
    uci set mt571x.lte.bands=''
    uci commit mt571x

    jq -n '{success: true, message: "已恢复出厂 5G+LTE 自动搜索模式及全频段掩码"}'
}

