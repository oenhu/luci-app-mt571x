# --- Action: unlock_nr ---
action_unlock_nr() {
    local res
    res=$(run_at 'AT^NRFREQLOCK=0' 4)
    local rc=$?
    if [ "$rc" -eq 0 ] && ! echo "$res" | grep -qi "ERROR"; then
        uci set mt571x.nr.mode='none'
        uci set mt571x.nr.bands=''
        uci set mt571x.nr.arfcn=''
        uci set mt571x.nr.pci=''
        uci commit mt571x
        run_at 'AT+COPS=0' 3 >/dev/null 2>&1 &
        jq -n '{success: true, message: "已成功解除 5G 频段/小区锁定"}'
    else
        jq -n '{success: false, error: "AT_ERROR", message: "解除 5G 锁定失败"}'
    fi
}

