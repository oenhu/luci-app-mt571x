#!/bin/sh /etc/rc.common
# Copyright (C) 2026 MT571x LuCI Plugin

START=19
USE_PROCD=1

PROG=/usr/bin/mt571x-at

start_service() {
    local enabled=$(uci -q get mt571x.main.enabled || echo 1)
    [ "$enabled" = "1" ] || return 0

    logger -t mt571x "Initializing MT5710/MT5711 modem support..."

    # Ensure option driver is loaded and target VID/PID bound
    $PROG --ensure-driver

    # Locate AT port and create symlink
    local port=$($PROG --port 2>/dev/null)
    if [ -n "$port" ] && [ -e "$port" ]; then
        logger -t mt571x "MT5710/MT5711 AT port ready at $port (linked to /dev/mt571x-at)"
    else
        logger -t mt571x "MT5710/MT5711 device not detected on USB bus"
    fi
}

stop_service() {
    rm -f /dev/mt571x-at 2>/dev/null
}

reload_service() {
    start_service
}
